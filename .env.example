# ── 登入 ───────────────────────────────────────────────
ADMIN_PASSWORD=                           # 必填，至少 12 個字元（建議 24 字元以上的隨機字串）
ADMIN_PORT=3940
ADMIN_HOST=127.0.0.1                      # 容器裡設 0.0.0.0（Dockerfile 已預設），並經由 HTTPS 反向代理存取
ADMIN_SESSION_HOURS=168                   # 登入有效時數（預設 7 天）
ADMIN_SESSION_SECRET=                     # 選填，簽 Cookie 的金鑰；未設定時自動產生並存在 data/admin-session-secret
# ADMIN_TRUSTED_PROXIES=172.18.0.0/16     # 選填，信任哪些反向代理帶來的 X-Forwarded-For（逗號分隔的 CIDR）；
                                          # 沒設定＝信任私有網段；none＝不讀 X-Forwarded-For

# ── 要管理的 Bot ───────────────────────────────────────
# 逗號分隔的「代號=管理 API 網址」，順序就是面板上的顯示順序（代號：小寫英數字與 -）
PANEL_BOTS=mousebot=http://127.0.0.1:3941,lite=http://127.0.0.1:3942
# 各 Bot 的管理 API 金鑰：PANEL_TOKEN_<代號大寫，- 換成 _>，要和那隻 Bot 的 ADMIN_AGENT_TOKEN 相同（至少 32 字元）
# 產生：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PANEL_TOKEN_MOUSEBOT=
PANEL_TOKEN_LITE=
# PANEL_TOKEN=                            # 所有 Bot 共用同一把金鑰時，只設這個也可以

# ── 其他（選填）────────────────────────────────────────
# PANEL_DATA_DIR=./data                   # Session 金鑰、登出清單、操作紀錄的位置
# ALERT_WEBHOOK_URL=                      # 登入被鎖定時通知的 Discord webhook
# ALERT_NAME=admin-panel
# LOG_LEVEL=info
